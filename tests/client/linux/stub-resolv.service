# Test fixture: Docker rewrites /etc/resolv.conf when the container starts. Distributions
# that use systemd-resolved link it to the stub resolver; restore that at every boot.
[Unit]
Description=Point resolv.conf at the systemd-resolved stub
DefaultDependencies=no
Before=systemd-resolved.service network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo "nameserver 127.0.0.53" > /etc/resolv.conf'

[Install]
WantedBy=sysinit.target
